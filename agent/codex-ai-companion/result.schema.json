{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "rewrite", "why", "method", "risk"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "rewrite": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "why": { "type": "string", "minLength": 1, "maxLength": 240 },
    "method": { "type": "string", "minLength": 1, "maxLength": 120 },
    "risk": { "type": "string", "maxLength": 240 }
  }
}
