{
  "manifest_version": 3,
  "name": "AI 伴学层",
  "version": "1.4.0",
  "description": "打开新标签页直达常用页面，并快速进入跨学科判断力知识库。",
  "minimum_chrome_version": "116",
  "homepage_url": "https://ai-knowledge-sigma.vercel.app/knowledge-map",
  "permissions": ["storage", "topSites"],
  "icons": {
    "16": "extension/icons/icon-16.png",
    "32": "extension/icons/icon-32.png",
    "48": "extension/icons/icon-48.png",
    "128": "extension/icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "extension/newtab.html"
  }
}
